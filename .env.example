# Copy to .env (gitignored) — `cp .env.example .env`.
# MarketPay Cloud API, pre-production. Replace these example values locally.
MARKETPAY_BASE_URL=https://marketpay.example.test
MARKETPAY_STORE_CODE=some_store_code
MARKETPAY_CURRENCY=752
MARKETPAY_TERMINAL_ID=PAX:TEST_TERMINAL
MARKETPAY_ECR_ID=TEST_ECR_ID
MARKETPAY_USER_AGENT=TestAssignment/1.0
# Paths inside the container; docker-compose mounts secrets/certs here read-only.
MARKETPAY_CLIENT_CERT=/run/secrets/marketpay/CLIENT_CERT.crt
MARKETPAY_CLIENT_KEY=/run/secrets/marketpay/CLIENT_CERT.key

# Firestore. docker-compose mounts secrets/firestore-service-account.json and sets
# GOOGLE_APPLICATION_CREDENTIALS; set FIRESTORE_EMULATOR_HOST instead to use an emulator.
GOOGLE_CLOUD_PROJECT=example-project
FIRESTORE_DATABASE=(default)

# MarketPay notifications (the bonus webhook): off unless both are set.
# NOTIFICATION_BASE_URL: public HTTPS base, e.g. the cloudflared tunnel (see docker-compose.yml).
# NOTIFICATION_SECRET: >= 32 random characters (`openssl rand -hex 32`); it signs each
# notification URL, which is the ONLY proof a notification came from MarketPay. Keep it secret.
# NOTIFICATION_BASE_URL=https://example.trycloudflare.com
# NOTIFICATION_SECRET=

INSTANCE_ID=local-1
LOG_LEVEL=INFO
LOG_FORMAT=console
